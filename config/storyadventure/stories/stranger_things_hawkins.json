        "triggers": [
          {
            "id": "bg_story_1",
            "label": "背景故事1",
            "target_distance": 20.0,
            "oneShot": true,
            "onEnter": [
              {
                "type": "MESSAGE",
                "text": "§7[旁白] §f霍金斯镇最近并不平静。几天前，年轻的威尔·拜尔斯在回家的路上神秘失踪了。",
                "voiceover": "stranger_things_hawkins/bg_story_1_msg_0"
              }
            ]
          }
        ]
      },
      "on_enter": [
        {
          "type": "MESSAGE",
          "text": "§e[任务] §f前往地下室和伙伴们商量搜寻威尔的计划",
          "voiceover": "stranger_things_hawkins/find_the_boys_enter_msg_0"
        }
      ],
      "edges": [
        {
          "target": "meet_the_boys",
          "conditions": [
            {
              "type": "TASK_COMPLETE"
            }
          ]
        }
      ]
    },
    "meet_the_boys": {
      "type": "dialogue",
      "data": {
        "npc_template": "npc_02_mike_wheeler",
        "dialog_set": "main",
        "npc_name": "迈克·威勒",
        "lines": [
          "威尔失踪了，我们必须找到他！",
          "我们昨晚在树林里看到了一些奇怪的东西...",
          "我们应该先去警局，看看霍珀警长有没有什么新消息。"
        ],
        "choices": [
          {
            "id": "go_to_police",
            "text": "好，我们去警局找霍珀。"
          }
        ],
        "voiceover": "stranger_things_hawkins/meet_the_boys_voice"
      },
      "edges": [
        {
          "target": "find_hopper",
          "conditions": [
            {
              "type": "DIALOGUE_CHOICE",
              "value": "go_to_police"
            }
          ]
        }
      ]
    },
