        "triggers": [
          {
            "id": "bg_story_2",
            "label": "背景故事2",
            "target_distance": 25.0,
            "oneShot": true,
            "onEnter": [
              {
                "type": "MESSAGE",
                "text": "§f搜救队找遍了森林却一无所获。奇怪的是，电力系统开始频繁故障，灯光闪烁不停，仿佛某种未知力量在干扰。",
