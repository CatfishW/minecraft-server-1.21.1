    "meet_hopper": {
      "type": "dialogue",
      "data": {
        "npc_template": "npc_06_jim_hopper",
        "dialog_set": "main",
        "npc_name": "吉姆·霍珀",
        "lines": [
          "听着，孩子们，搜救工作正在进行中。",
          "乔伊斯的状态不太好，她一直在胡言乱语。",
          "如果你们真的想帮忙，去她家看看她吧。"
        ],
        "choices": [
          {
            "id": "ask_about_joyce",
            "text": "乔伊斯现在的情况怎么样？"
          },
          {
            "id": "ask_about_search",
            "text": "搜救工作有什么发现吗？"
          },
          {
            "id": "go_to_joyce",
            "text": "好的，我们现在就去见乔伊斯。"
          }
        ],
        "voiceover": "stranger_things_hawkins/meet_hopper_voice",
        "profile_id": "hopper"
      },
      "on_enter": [],
      "edges": [
        {
          "target": "hopper_answer_joyce",
          "conditions": [
            {
              "type": "DIALOGUE_CHOICE",
              "value": "ask_about_joyce"
            }
          ]
        },
        {
          "target": "hopper_answer_search",
          "conditions": [
            {
              "type": "DIALOGUE_CHOICE",
              "value": "ask_about_search"
            }
          ]
        },
        {
          "target": "take_bus_to_joyce",
          "conditions": [
            {
              "type": "DIALOGUE_CHOICE",
              "value": "go_to_joyce"
            }
          ]
        }
      ]
    },
    "hopper_answer_joyce": {
      "type": "dialogue",
      "data": {
        "npc_template": "npc_06_jim_hopper",
        "npc_name": "吉姆·霍珀",
        "lines": [
          "她崩溃了。她声称威尔在墙里和她说话，还通过灯泡发信号。",
          "作为母亲，她的心情可以理解，但那些话听起来真的太疯狂了。"
        ],
        "choices": [
          {
            "id": "go_to_joyce",
            "text": "听起来很诡异，我们去看看她。"
          }
        ],
        "profile_id": "hopper",
        "voiceover": "stranger_things_hawkins/hopper_answer_joyce_voice"
      },
      "edges": [
        {
          "target": "take_bus_to_joyce",
          "conditions": [
            {
              "type": "DIALOGUE_CHOICE",
              "value": "go_to_joyce"
            }
          ]
        }
      ]
    },
    "hopper_answer_search": {
      "type": "dialogue",
      "data": {
        "npc_template": "npc_06_jim_hopper",
        "npc_name": "吉姆·霍珀",
        "lines": [
          "只有那辆自行车。其他的什么都没有。没有足迹，没有衣服碎片，什么都没有。",
          "就像他凭空蒸发了一样。"
        ],
        "choices": [
          {
            "id": "go_to_joyce",
            "text": "我们会尽力帮忙的。现在先去找乔伊斯。"
          }
        ],
        "profile_id": "hopper",
        "voiceover": "stranger_things_hawkins/hopper_answer_search_voice"
      },
      "edges": [
