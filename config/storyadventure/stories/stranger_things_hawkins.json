        },
        {
          "type": "COMMAND",
          "command": "bossbar set boss_{instance_id_safe} color red",
          "as_op": true
        },
        {
          "type": "COMMAND",
          "command": "bossbar set boss_{instance_id_safe} style notched_10",
          "as_op": true
        },
        {
          "type": "COMMAND",
          "command": "bossbar set boss_{instance_id_safe} max 500",
          "as_op": true
        },
        {
          "type": "COMMAND",
          "command": "bossbar set boss_{instance_id_safe} value 500",
          "as_op": true
        },
        {
          "type": "COMMAND",
          "command": "bossbar set boss_{instance_id_safe} players @a",
          "as_op": true
        },
        {
          "type": "COMMAND",
          "command": "easy_npc scale @e[tag=demogorgon_boss_entity,tag=instance_{instance_id},limit=1] main 1.96",
          "as_op": true
        },
        {
          "type": "COMMAND",
          "command": "execute store result bossbar boss_{instance_id_safe} value run data get entity @e[tag=demogorgon_boss_entity,tag=instance_{instance_id},limit=1] Health",
          "as_op": true
        },
        {
          "type": "COMMAND",
          "command": "bossbar remove boss_{instance_id_safe}",
          "as_op": true
        }
      ],
      "on_exit": [
