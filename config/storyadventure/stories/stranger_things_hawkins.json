            "target_distance": 25.0,
            "oneShot": true,
            "onEnter": [
              {
                "type": "MESSAGE",
                "text": "§7[旁白] §f搜救队找遍了森林却一无所获。奇怪的是，电力系统开始频繁故障，灯光闪烁不停，仿佛某种未知力量在干扰。",
                "voiceover": "stranger_things_hawkins/bg_story_2_msg_0"
              }
            ]
          }
        ]
      },
      "on_enter": [
        {
          "type": "MESSAGE",
          "text": "§e[任务] §f询问霍珀警长关于搜索的进展",
