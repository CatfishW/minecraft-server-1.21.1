      "type": "dialogue",
      "data": {
        "npc_template": "npc_06_jim_hopper",
        "dialog_set": "main",
        "npc_name": "吉姆·霍珀",
        "lines": [
          "听着，孩子们，搜救工作正在进行中。",
          "乔伊斯的状态不太好，她一直在胡言乱语。",
          "如果你们真的想帮忙，去她家看看她吧。"
        ],
        "choices": [
          {
            "id": "go_to_joyce",
            "text": "明白了，我们这就去乔伊斯家。"
          }
        ],
        "voiceover": "stranger_things_hawkins/meet_hopper_voice"
      },
      "edges": [
