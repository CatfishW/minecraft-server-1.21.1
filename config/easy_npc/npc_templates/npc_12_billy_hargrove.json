        "maxHealth": 40,
        "movementSpeed": 0.3,
        "attackDamage": 5.0,
        "armor": 5.0,
        "invulnerable": false,
        "attackableByPlayers": true,
        "attackableByMonsters": true
    },
    "objectives": {
        "attackHostileMobs": true,
        "attackPlayers": false,
        "returnToSpawn": false,
        "wanderRange": 25.0
    },
    "dialogs": {
        "main": {
            "greeting": "（他猛地转身，眼神充满野性，手中紧握着一把附魔钻石剑）嘿，小子，我认得你的眼神。你是想来挑战我，还是单纯想找死？别在我面前晃悠，我脾气可不好，尤其是现在。",
            "buttons": [
                {
                    "label": "§6§l接受任务",
                    "action": "OPEN_QUEST_DIALOG:RANDOM_POOL:4b52098a-c7e6-44ed-9c41-9c491758dacb,11cc8d0e-d1ec-4bfc-b48d-021edeb6e826,e1b2fcaa-2124-4429-bec0-e0041f52c17b,c21baa36-4e2d-4689-a945-f74366b0de57,608d057f-7a94-4461-be7d-d51414088fb4",
                    "id": "btn_quest_916b5111"
                },
                {
                    "label": "你看起来很生气。",
                    "action": "SHOW_DIALOG:story_1",
                    "id": "btn_billy_start"
                },
                {
                    "label": "不想死就滚开。",
                    "action": "SHOW_DIALOG:story_2",
                    "id": "btn_billy_threaten"
                },
                {
                    "label": "再见",
                    "action": "CLOSE_DIALOG",
                    "id": "btn_close_16c3b82e"
                }
            ],
            "oneTimeConversation": true
        },
        "story_1": {
            "greeting": "生气？这词太轻了。我被困在这个该死的方块世界里，那个讨厌的小鬼（指Max）整天像个苍蝇一样围着我转。还有那些怪物... 来吧，让我把怒火发泄在你身上！",
            "buttons": [
                {
                    "label": "我不想打架。",
                    "action": "SHOW_DIALOG:story_1_1",
                    "id": "btn_billy_peace"
                },
                {
                    "label": "你太弱了。",
                    "action": "SHOW_DIALOG:story_1_2",
                    "id": "btn_billy_taunt"
                }
            ]
        },
        "story_1_1": {
            "greeting": "不想打架？那你就是个懦夫！在这个世界上，只有强者才能生存。看看我，这就是力量的代价。如果你不握紧你的剑，下一个倒下的就是你！",
            "buttons": [
                {
                    "label": "我会记住的。",
                    "action": "SHOW_DIALOG:story_conclusion",
                    "id": "btn_billy_remember"
                },
                {
                    "label": "你被某种东西控制了吗？",
                    "action": "SHOW_DIALOG:story_conclusion",
                    "id": "btn_billy_suspicious"
                }
            ]
        },
        "story_1_2": {
            "greeting": "（大笑）弱？我可是这里最强的男人！来，拔剑！让我看看你有什么本事。如果你能接下我三招，我就饶你不死。但如果不能... 呵呵。",
            "buttons": [
                {
                    "label": "拔剑决斗",
                    "action": "SHOW_DIALOG:story_conclusion",
                    "id": "btn_billy_fight"
                },
                {
                    "label": "激将法没用",
                    "action": "SHOW_DIALOG:story_conclusion",
                    "id": "btn_billy_ignore"
                }
            ]
        },
        "story_2": {
            "greeting": "哦？还挺横。我喜欢有骨气的人，因为把骨头打断的声音最好听。我以前在霍金斯也是这么对那些敢顶撞我的家伙的。现在，跪下，叫我一声老大，也许我能让你少受点罪。",
            "buttons": [
                {
                    "label": "绝不。",
                    "action": "SHOW_DIALOG:story_2_1",
                    "id": "btn_billy_no"
                },
                {
                    "label": "休想。",
                    "action": "SHOW_DIALOG:story_2_1",
                    "id": "btn_billy_never"
                }
            ]
        },
        "story_2_1": {
            "greeting": "好，很好。我就喜欢这种硬骨头。这样打碎起来才过瘾。准备好了吗？这可是你自找的！（他摆出了攻击姿态，周围空气仿佛都变冷了）",
            "buttons": [
                {
                    "label": "时刻准备着。",
                    "action": "SHOW_DIALOG:story_conclusion",
                    "id": "btn_billy_ready"
                },
                {
                    "label": "这可是你说的。",
                    "action": "SHOW_DIALOG:story_conclusion",
                    "id": "btn_billy_warn"
                }
            ]
        },
        "story_conclusion": {
            "greeting": "哼，算你走运，我突然没兴趣了。但这不代表事情结束了。下次再让我看到你，我保证会让你后悔出生在这个世界上。现在，滚出我的视线。",
            "buttons": [
                {
                    "label": "后会有期。",
                    "action": "CLOSE_DIALOG",
                    "id": "btn_billy_bye"
                }
            ]
        }
    },
    "pose": "STANDING",
    "equipment": {
        "mainHand": {
            "item": "minecraft:iron_sword",
            "count": 1
        }
    },
