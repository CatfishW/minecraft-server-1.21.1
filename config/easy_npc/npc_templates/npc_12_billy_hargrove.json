{
    "name": "§aBilly Hargrove",
    "entityType": "easy_npc:humanoid",
    "faction": "default",
    "description": "Antagonist stepbrother. Wild and dangerous.",
    "skin": {
        "type": "URL_SKIN",
        "skinUrl": "https://www.minecraftskins.com/uploads/skins/2023/03/17/billy-hargrove-21430544.png?v938"
    },
