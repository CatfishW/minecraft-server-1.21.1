    "dialogs": {
        "main": {
            "greeting": "你好。我是沃尔特·怀特，化学老师。有什么我能帮你的吗？\n\n（他靠在椅子上，眼神中带着一丝戒备和不易察觉的疲倦）",
            "buttons": [
                {
                    "label": "关于你自己",
                    "action": "SHOW_DIALOG:about_walter",
                    "id": "btn_about"
                },
                {
                    "label": "Gray Matter科技",
                    "action": "SHOW_DIALOG:backstory_gray_matter_lock",
                    "id": "btn_gray_matter"
                },
                {
                    "label": "你的处境",
                    "action": "SHOW_DIALOG:current_situation_lock",
