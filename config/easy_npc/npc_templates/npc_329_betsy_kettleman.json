        "maxCount": 30,
        "chance": 0.5,
        "playerKillOnly": true
    },
    "objectives": {
        "attackHostileMobs": true,
        "attackPlayers": false,
        "wanderRange": 50.0,
        "returnToSpawn": false
    }
