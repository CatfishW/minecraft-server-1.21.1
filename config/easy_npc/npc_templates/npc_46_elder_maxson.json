    "dialogs": {
        "main": {
            "greeting": "公民。你踏入了钢铁兄弟会的领地，这里是秩序与原则的庇护所。在这一片废土的混乱中，我们是唯一能够重建文明的力量。告诉我，你的来意是什么？我们不欢迎漫无目的的闲逛者。",
            "buttons": [
                {
                    "label": "§6§l接受任务",
                    "action": "OPEN_QUEST_DIALOG:RANDOM_POOL:84f131f6-6739-4af5-8a60-3d32ae5e8845,39ea448d-4b89-4865-8310-0fc0a7e52314,99b85c34-2cac-460d-8dd2-ea983f7bfe45,c8edeb04-8aa3-4aca-ab90-fe26d9313aa7,6bf8d649-b480-4137-acfd-0f18134f8ff1",
                    "id": "btn_quest_066a1fd4"
                },
                {
                    "label": "询问兄弟会的目标",
                    "action": "SHOW_DIALOG:story_1",
                    "id": "btn_ask_goal"
                },
                {
                    "label": "展示你获得的战利品",
                    "action": "SHOW_DIALOG:story_2",
                    "id": "btn_show_loot"
                },
                {
                    "label": "再见",
                    "action": "CLOSE_DIALOG",
                    "id": "btn_close_60644806"
                }
            ],
            "oneTimeConversation": true
        },
        "story_1": {
            "greeting": "我们的目标很明确：回收所有危险的高科技，将它们从无知的掠夺者手中夺回，直到我们将人类带回失落的黄金时代。任何滥用科技的行为都是对未来的背叛。你若是认同这份理想，或许能为我们所用。",
            "buttons": [
                {
                    "label": "我愿意协助回收科技",
                    "action": "SHOW_DIALOG:story_3",
                    "id": "btn_join"
                },
                {
                    "label": "你们这是在垄断技术",
                    "action": "SHOW_DIALOG:story_4",
                    "id": "btn_critique"
                }
            ]
        },
        "story_2": {
            "greeting": "这把武器……做工精良。它曾经属于那个疯子骑士，对吗？很好。如果你能从那些野蛮人手中夺取这种力量，说明你至少懂得分辨优劣。把它们交给我们，我们会给予你应有的报酬。",
            "buttons": [
                {
                    "label": "交易完成",
                    "action": "CLOSE_DIALOG",
                    "id": "btn_trade"
                },
                {
                    "label": "我想知道更多关于骑士的事",
                    "action": "SHOW_DIALOG:story_1",
                    "id": "btn_knight_info"
                }
            ]
        },
        "story_3": {
            "greeting": "明智的选择。但请记住，背叛兄弟会的下场只有一个。去废土中寻找那些失落的神器吧，将它们带回普罗维登斯的飞艇残骸处。我们的技术员会处理剩下的事情。不要让我们失望，骑士。",
            "buttons": [
                {
                    "label": "为了钢铁！",
                    "action": "CLOSE_DIALOG",
                    "id": "btn_steel"
                },
                {
                    "label": "我还有最后一个问题",
                    "action": "SHOW_DIALOG:story_1",
                    "id": "btn_more"
                }
            ]
        },
        "story_4": {
            "greeting": "垄断？这是保护！让那些拾荒者拿着核子手雷乱跑就是你所谓的自由？退下吧，你的言论充满了危险的幼稚。除非你改变想法，否则这里没有你的位置。",
            "buttons": [
                {
                    "label": "我再考虑一下",
                    "action": "CLOSE_DIALOG",
                    "id": "btn_leave_angry"
                },
                {
                    "label": "我收回刚才的话，我需要证明自己",
                    "action": "SHOW_DIALOG:story_3",
                    "id": "btn_redemption"
                }
            ]
        }
    },
