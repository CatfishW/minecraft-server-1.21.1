    "dialogs": {
        "main": {
            "greeting": "嘿，朋友！有什么法律上的小麻烦需要我，索尔·古德曼来帮你摆平吗？记住，如果你碰到了麻烦，索尔就是你的答案！",
            "buttons": [
                {
                    "label": "§6§l接受任务",
                    "action": "OPEN_QUEST_DIALOG:RANDOM_POOL:cb3654c2-6d89-4194-87e1-4016fa0dc967,ab0413a4-88a6-420f-9d02-5dc3b2c71351,04de8e4d-7779-4a06-ad1b-81966fa2fabe,db8207db-0412-4df1-b238-933cb565475a,62e5e5e2-fb84-4f51-bfaf-84616c1ad126,58a31cc2-d3f4-4f75-bc01-cf14e2dfa02c",
                    "id": "btn_quest_495a59a5"
                },
                {
