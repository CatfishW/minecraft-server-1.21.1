                }
            ]
        },
        "farewell": {
            "greeting": "§9行了，谈心时间结束。§r 我还有事要忙，比如继续我的‘找死’大业，或者找个地方抽根烟。如果你听到任何关于Rachel的消息…（她犹豫了一下）…你知道在哪能找到我。",
            "buttons": [
                {
                    "label": "保重，Chloe。",
                    "action": "CLOSE_DIALOG",
