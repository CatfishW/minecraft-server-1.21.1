    "dialogs": {
        "main": {
            "greeting": "§eNacho Varga§r环顾四周，确认没人注意你们，低声说道：\"你看起来不像这里常见的人。想聊聊？但说话小心点，墙壁有耳朵。\"",
            "buttons": [
                {
                    "label": "简单聊聊",
                    "action": "SHOW_DIALOG:small_talk",
                    "id": "btn_chitchat"
                },
                {
                    "label": "关于你父亲",
                    "action": "SHOW_DIALOG:backstory_father",
                    "id": "btn_father"
                },
                {
                    "label": "你怎么为萨拉曼加家做事？",
                    "action": "SHOW_DIALOG:backstory_recruitment",
                    "id": "btn_how_work"
                },
                {
                    "label": "最近好像有事发生？",
                    "action": "SHOW_DIALOG:current_tension",
                    "id": "btn_current"
                },
                {
                    "label": "我或许能帮忙",
