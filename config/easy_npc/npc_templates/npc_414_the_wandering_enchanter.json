{
    "name": "§9The Wandering Enchanter",
    "entityType": "easy_npc:humanoid",
    "description": "A robed figure who appears at random, offering powerful enchantments in exchange for exotic items. No one knows their true face or origin.",
    "skin": {
        "type": "URL_SKIN",
