                    "action": "SHOW_DIALOG:main",
                    "id": "btn_back"
                }
            ]
        },
        "quest_intro": {
            "greeting": "我们的竞争对手最近很不老实。我需要你去把他们仓库的电源切断，持续一小时。这会给他们造成巨大的损失，而且查不出人为痕迹。你能保证绝对的精确吗？",
            "buttons": [
                {
                    "label": "绝对精确",
